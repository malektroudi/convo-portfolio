# This repo is written on Windows and runs on Linux (Cloud Run, Cloud Build, CI),
# so pin the line endings that matter rather than leaving them to core.autocrlf.
* text=auto

# CRLF in a shell script makes Linux report "bad interpreter: /bin/bash^M".
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf

# PowerShell is happier with CRLF.
*.ps1 text eol=crlf

# Written by uv; never hand-merge it.
uv.lock linguist-generated=true

# Day 8's chunk offsets are character indexes into these files. A CRLF
# checkout would shift every one of them, so pin the corpus to LF.
src/convo/projects/day08_rag_cites/corpus/*.md text eol=lf

# Newline-delimited JSON is newline-delimited. `bq load` reads it line by
# line, and a Windows checkout handing it CRLF is a loader problem nobody
# would look for in a data file.
*.ndjson text eol=lf
